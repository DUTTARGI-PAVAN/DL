# Cell 1 - imports (matplotlib was missing in your file)
import numpy as np
import tensorflow as tf
from tensorflow import keras
from tensorflow.keras import layers
import matplotlib.pyplot as plt

# Cell 2 - load, normalise, pick normal/anomalous data
(x_train, y_train), (x_test, y_test) = keras.datasets.mnist.load_data()
x_train = x_train.astype("float32") / 255.0
x_test = x_test.astype("float32") / 255.0
x_train = x_train[y_train == 0]                      # train only on zeros (5923 images)
mask = np.isin(y_test, [0, 1])                       # test on zeros and ones
x_test, y_test = x_test[mask], y_test[mask]          # 2115 images (980 zeros, 1135 ones)

# Cell 3 - flatten 28x28 -> 784
x_train = x_train.reshape(-1, 784)
x_test = x_test.reshape(-1, 784)

# Cell 4 - build autoencoder
input_layer = keras.Input(shape=(784,))
encoded = layers.Dense(128, activation="relu")(input_layer)     # encoder
encoded = layers.Dense(32, activation="relu")(encoded)          # latent (bottleneck)
decoded = layers.Dense(128, activation="relu")(encoded)         # decoder
output_layer = layers.Dense(784, activation="sigmoid")(decoded)
autoencoder = keras.Model(input_layer, output_layer)
autoencoder.summary()

# Cell 5 - compile
autoencoder.compile(optimizer="adam", loss="mse", metrics=["mae"])

# Cell 6 - train: input AND target are both x_train
autoencoder.fit(x_train, x_train, epochs=5, batch_size=128, validation_split=0.1)

# Cell 7 - reconstruction error and threshold
reconstructed = autoencoder.predict(x_test)
error = np.mean((x_test - reconstructed) ** 2, axis=1)       # one error per image
threshold = np.percentile(error[y_test == 0], 95)
print("Anomaly threshold:", threshold)

# Cell 8 - detect anomalies
predictions = error > threshold            # True = anomaly
for i in range(10):
    print("Image", i, "-", "Anomaly" if predictions[i] else "Normal")
print("Detection accuracy:", np.mean(predictions == (y_test == 1)))   # optional extra

# Cell 9 - original vs reconstructed
plt.figure(figsize=(10, 4))
for i in range(5):
    plt.subplot(2, 5, i + 1)
    plt.imshow(x_test[i].reshape(28, 28), cmap="gray"); plt.title("Original"); plt.axis("off")
    plt.subplot(2, 5, i + 6)
    plt.imshow(reconstructed[i].reshape(28, 28), cmap="gray"); plt.title("Reconstructed"); plt.axis("off")
plt.tight_layout()
plt.show()
